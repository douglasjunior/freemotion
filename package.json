{
  "name": "freemotion-monorepo",
  "version": "0.1.1",
  "private": true,
  "description": "Make videos with React. Monorepo of the freemotion runtime, CLI and companion packages.",
  "author": {
    "name": "Douglas Nassif Roma Junior",
    "email": "nassifrroma@gmail.com",
    "url": "https://github.com/douglasjunior"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/douglasjunior/freemotion.git"
  },
  "bugs": {
    "url": "https://github.com/douglasjunior/freemotion/issues"
  },
  "homepage": "https://github.com/douglasjunior/freemotion",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter freemotion run build && pnpm --filter '!freemotion' -r run build",
    "ts": "pnpm -r run ts",
    "lint": "eslint . --cache --cache-location .eslintcache/",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter freemotion run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
